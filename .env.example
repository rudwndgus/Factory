ZERO_COST_MODE=true
DATA_DIR=./data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=
# Set a long random password. Never use your Google password.
OWNER_PASSWORD=
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://rudwndgus.github.io
# Local LLM (Ollama is an external local service)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREADS=6
OLLAMA_KEEP_ALIVE=2m

# Free-quota image generation. Paid fallback is forbidden in Zero Cost Mode.
IMAGE_PROVIDER=cloudflare
IMAGE_FALLBACK_PROVIDER=none
IMAGE_PROVIDER_TIMEOUT_SECONDS=60
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_IMAGE_FORMAT=jpg

# Local TTS
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_LANG_CODE=a
KOKORO_SPEED=1.0
KOKORO_SAMPLE_RATE=24000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
PEXELS_API_KEY=
FFMPEG_PATH=
GLOBAL_DAILY_BUDGET=0
GLOBAL_MONTHLY_BUDGET=0

# Stable remote access (optional). Create a remotely-managed Cloudflare Tunnel,
# publish its hostname to http://127.0.0.1:8000, then paste its connector token.
CLOUDFLARE_TUNNEL_TOKEN=
FIXED_API_URL=
